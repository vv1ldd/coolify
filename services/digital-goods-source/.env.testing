APP_NAME="Digital Goods Source"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=sqlite
DB_DATABASE=:memory:
CACHE_STORE=array

DIGITAL_GOODS_SOURCE_SERVICE_NAME=digital-goods-source
DIGITAL_GOODS_SOURCE_RUNTIME_VERSION=1.0.0
DIGITAL_GOODS_SOURCE_KERNEL_PROTOCOL_VERSION=v1
DIGITAL_GOODS_SOURCE_PROVIDER_CONTRACT_VERSION=v1
DIGITAL_GOODS_SOURCE_PLATFORM_TOKEN=kernel-platform-token
DIGITAL_GOODS_SOURCE_FINANCIAL_SECRET=kernel-financial-secret
DIGITAL_GOODS_SOURCE_SIGNATURE_TOLERANCE=300
